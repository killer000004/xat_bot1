# Telegram bot token — @BotFather dan oling
BOT_TOKEN=123456789:AAExampleTokenHere

# Bu API kalitni websayt backend bilan bogʻlashda ishlatasiz.
# Oʻzingiz uzun va tasodifiy qiymat qoʻying (masalan: openssl rand -hex 32)
API_KEY=o_zgartiring_shu_yerda_uzun_random_qiymat

# API server qaysi portda ishga tushsin
PORT=3000

# Admin Telegram ID'lari (vergul bilan ajratilgan), /addfaq, /broadcast kabi buyruqlar faqat shularga ruxsat beradi
ADMIN_IDS=111111111,222222222

# SQLite fayl nomi
DB_FILE=./data/bot.sqlite
